# ============================================================
# AffiGuard – Environment Variables
# ── Render backend: set these in Render dashboard
# ── Local dev: copy to .env in backend/ folder
# ============================================================

# ── Flask ────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-64-char-secret-here
FLASK_ENV=production

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Cron Security ─────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
CRON_API_KEY=your-cron-api-key-here

# ── Admin Secret ─────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=your-admin-secret-here

# ── Telegram Alerts ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRstuVwXyz

# ── Telegram Webhook Secret (optional) ───────────────────────
# For extra security, set a secret and validate incoming webhook requests
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-here

# ── Email (Password Reset) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=your-email@gmail.com

# ── Smart Proxy Network (formerly ScraperAPI) ────────────────
# Get from proxy provider dashboard
PROXY_API_KEY=your-proxy-api-key-here
# Old name still works for backward compatibility
SCRAPER_API_KEY=your-proxy-api-key-here

# ── Playwright (Layer 3) ──────────────────────────────────────
# KEEP FALSE on Render free tier (512 MB RAM)
ENABLE_PLAYWRIGHT=false

# ── Frontend URL (Vercel) ─────────────────────────────────────
FRONTEND_URL=https://your-project.vercel.app

# ── Rate Limiting ─────────────────────────────────────────────
FREE_CHECKER_LIMIT=10
